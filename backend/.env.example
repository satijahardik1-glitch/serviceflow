# development | production  (production enforces strong secrets and disables /docs)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/serviceflow

# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Encrypts ID numbers at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production. Back it up - losing it makes stored ID numbers unreadable.
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
